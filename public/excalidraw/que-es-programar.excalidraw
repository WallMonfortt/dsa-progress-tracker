      "versionNonce": 1779214642,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1758847260429,
      "link": null,
      "locked": false,
      "text": "Dirigido: Las aristas tienen dirección (por\nejemplo, A → B no implica B → A).",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dirigido: Las aristas tienen dirección (por ejemplo, A → B no implica B → A).",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "PAP51m48W2P1HattN_0Ee",
      "type": "text",
      "x": -275.2535942110417,
      "y": 9021.555534619087,
      "width": 798.3356323242188,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 60,
      "groupIds": [],
      "frameId": null,
      "index": "c2Ms",
      "roundness": null,
      "seed": 63739146,
      "version": 687,
      "versionNonce": 1422177010,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1758847260429,
      "link": null,
      "locked": false,
      "text": "No dirigido: Las aristas son bidireccionales (A\n↔ B).",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "No dirigido: Las aristas son bidireccionales (A ↔ B).",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
