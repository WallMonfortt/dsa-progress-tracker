      "isDeleted": false,
      "boundElements": [],
      "updated": 1758844877305,
      "link": null,
      "locked": false,
      "text": "Input: nums = [1,2,3,4,5,6,7], k = 3\nOutput: [5,6,7,1,2,3,4]",
