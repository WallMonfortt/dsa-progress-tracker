      "roundness": null,
      "seed": 1635257175,
      "version": 609,
      "versionNonce": 547224242,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1758844877307,
      "link": null,
      "locked": false,
      "text": "Colisiones: Si la función hash no es buena o el arreglo es pequeño, las colisiones pueden \ndegradar el rendimiento a O(n).",
      "fontSize": 27.806294326241193,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Colisiones: Si la función hash no es buena o el arreglo es pequeño, las colisiones pueden \ndegradar el rendimiento a O(n).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "8nfl7mBuTO0Q8NQXIV7x7",
      "type": "text",
      "x": -6188.324226290927,
      "y": -2596.0757624854746,
      "width": 1109.391845703125,
      "height": 72.92054521276582,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "#000",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0Mj",
      "roundness": null,
      "seed": 2095503255,
      "version": 1067,
      "versionNonce": 1012515182,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1758844877307,
      "link": null,
      "locked": false,
      "text": "Espacio: Puede requerir más memoria si el arreglo es grande o si se usan listas\npara manejar colisiones.",
      "fontSize": 29.168218085106325,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Espacio: Puede requerir más memoria si el arreglo es grande o si se usan listas\npara manejar colisiones.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "p8BLAkProd8DlZf3QBQWR",
      "type": "text",
      "x": -6197.669240921662,
      "y": -2095.7017598259004,
      "width": 935.1490478515625,
      "height": 64.60106382978583,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "#000",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
