    },
    {
      "id": "PKIo5VpT8i3QOvc8tiE0b",
      "type": "text",
      "x": -12911.294047554118,
      "y": 4379.388358293885,
      "width": 1498.690673828126,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 70,
      "groupIds": [],
      "frameId": null,
      "index": "c2dc",
      "roundness": null,
      "seed": 1773793646,
      "version": 732,
      "versionNonce": 2128752814,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1758845350269,
      "link": null,
      "locked": false,
      "text": "Una de las formas mas eficientes de ver a las pilas son como arrays, ya que la\ncomplejidad de agregar elementos con push es O(1) y la de sacar pop es tambien O(1)",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Una de las formas mas eficientes de ver a las pilas son como arrays, ya que la complejidad de agregar elementos con push es O(1) y la de sacar pop es tambien O(1)",
      "autoResize": false,
      "lineHeight": 1.25
    },
