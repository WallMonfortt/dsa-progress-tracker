      "isDeleted": false,
      "boundElements": [],
      "updated": 1758832917604,
      "link": null,
      "locked": false,
      "text": "Un elemento con mayor prioridad se\ndesencola antes que uno con menor\nprioridad.",
      "fontSize": 21.018622511552355,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un elemento con mayor prioridad se desencola antes que uno con menor prioridad.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "TBW8Iqrdh4xHPpLHyYUds",
      "type": "text",
      "x": -5204.686798431987,
      "y": 4691.386516726709,
      "width": 370.486948567487,
      "height": 68.2208760849874,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#2f9e44",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "dashed",
      "roughness": 2,
      "opacity": 70,
      "groupIds": [],
      "frameId": null,
      "index": "c2RY",
      "roundness": null,
      "seed": 872206190,
      "version": 1010,
      "versionNonce": 889787374,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1758832917604,
      "link": null,
      "locked": false,
      "text": "Si dos elementos tienen la misma\nprioridad, se respeta el orden de llegada\n(FIFO).",
      "fontSize": 18.192233622663313,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Si dos elementos tienen la misma prioridad, se respeta el orden de llegada (FIFO).",
      "autoResize": false,
      "lineHeight": 1.25
    },
