      "isDeleted": false,
      "boundElements": [],
      "updated": 1758847260429,
      "link": null,
      "locked": false,
      "text": "Por ejemplo, en un grafo de una red social, los\nnodos serían personas y las aristas\nrepresentarían amistades.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Por ejemplo, en un grafo de una red social, los nodos serían personas y las aristas representarían amistades.",
      "autoResize": false,
      "lineHeight": 1.25
    },
