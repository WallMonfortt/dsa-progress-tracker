      "boundElements": [],
      "updated": 1758844877305,
      "link": null,
      "locked": false,
      "text": "Given an integer array nums, rotate the array to the right by k steps, \nwhere k is non-negative.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Given an integer array nums, rotate the array to the right by k steps, \nwhere k is non-negative.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
