      "type": "text",
      "x": -6194.921939208279,
      "y": -2701.9683821663243,
      "width": 1185.6414794921875,
      "height": 69.51573581560298,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "#000",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
