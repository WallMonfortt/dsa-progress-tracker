    {
      "id": "hQwGskxDRrIQ8Q_qGSeSG",
      "type": "text",
      "x": -11321.309566528105,
      "y": -1622.0190048891036,
      "width": 1484.567626953125,
      "height": 495,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 4,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
