      "updated": 1758847260429,
      "link": null,
      "locked": false,
      "text": "Ponderado: Las aristas tienen un peso (por\nejemplo, distancias en un mapa).",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ponderado: Las aristas tienen un peso (por ejemplo, distancias en un mapa).",
      "autoResize": false,
      "lineHeight": 1.25
    },
