      "versionNonce": 2135727150,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1758832917604,
      "link": null,
      "locked": false,
      "text": "Enqueue (Encolar): Añade un elemento\nal final (rear o tail) de la cola.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Enqueue (Encolar): Añade un elemento al final (rear o tail) de la cola.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "tOr9FgsihgNhd03JoiNDK",
      "type": "text",
      "x": -7904.533150895202,
      "y": 4217.580127269864,
      "width": 638.63955252511,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c2P3",
      "roundness": null,
      "seed": 973406638,
      "version": 1252,
      "versionNonce": 402974318,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1758832917604,
      "link": null,
      "locked": false,
      "text": "Dequeue (Desencolar): Elimina el\nelemento del frente (front o head)\nde la cola.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dequeue (Desencolar): Elimina el elemento del frente (front o head) de la cola.",
      "autoResize": false,
      "lineHeight": 1.25
    },
