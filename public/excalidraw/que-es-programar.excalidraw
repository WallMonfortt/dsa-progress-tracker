      "updated": 1758842865380,
      "link": null,
      "locked": false,
      "text": "Esta implementación utiliza nodos que se enlazan entre sí. Se necesitan dos\npunteros: head (cabeza) y tail (cola).",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Esta implementación utiliza nodos que se enlazan entre sí. Se necesitan dos punteros: head (cabeza) y tail (cola).",
      "autoResize": false,
      "lineHeight": 1.25
    },
