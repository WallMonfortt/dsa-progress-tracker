    {
      "id": "rjr0P_UiJGErZKnyxuC0T",
      "type": "text",
      "x": -7941.972498986732,
      "y": 3712.215430195172,
      "width": 1343.202524038462,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
