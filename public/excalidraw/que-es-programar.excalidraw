      "versionNonce": 540005490,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1758844877307,
      "link": null,
      "locked": false,
      "text": "Sin orden: Las tablas hash no mantienen un orden específico de las claves \n(a diferencia de un arreglo o lista ordenada).",
      "fontSize": 25.840425531914335,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sin orden: Las tablas hash no mantienen un orden específico de las claves \n(a diferencia de un arreglo o lista ordenada).",
      "autoResize": true,
      "lineHeight": 1.25
    },
